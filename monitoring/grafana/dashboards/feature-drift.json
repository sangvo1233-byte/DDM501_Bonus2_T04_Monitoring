{
  "uid": "ddm501-bonus2-drift",
  "title": "WDBC Feature Drift and Registry",
  "tags": [
    "ddm501",
    "bonus2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Feature drift detected",
      "type": "stat",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ddm501-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "evidently_data_drift_detected",
          "legendFormat": "{{job}} {{version}}",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "red"
              }
            ],
            "mode": "absolute"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Drifting feature share",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ddm501-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "evidently_drifted_feature_share",
          "legendFormat": "{{job}} {{version}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Captured prediction window",
      "type": "stat",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ddm501-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "evidently_current_window_size",
          "legendFormat": "{{job}} {{version}}",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Serving registry version",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ddm501-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wdbc_model_info",
          "legendFormat": "{{job}} {{version}}",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "options": {
            "renameByName": {
              "sklearn_version": "scikit-learn",
              "version": "Registry version"
            },
            "excludeByName": {
              "Value": true,
              "Time": true,
              "instance": true,
              "__name__": true,
              "service": true,
              "job": true,
              "env": true
            }
          },
          "id": "organize"
        }
      ]
    }
  ]
}
